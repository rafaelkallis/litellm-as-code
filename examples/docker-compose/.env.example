# Copy to `.env` and fill in your secrets, or export them in your shell.
# compose.yml reads these (${VAR:-...} fallbacks). Never commit real keys.

# Required: the LiteLLM proxy master/admin key. Used by the proxy AND as the
# reconciler's admin API key.
LITELLM_MASTER_KEY=sk-demo-master-key-change-me

# Optional: salt key used to encrypt provider credentials in the DB.
# Set once and never change (LiteLLM limitation).
LITELLM_SALT_KEY=sk-demo-salt-key-change-me

# Optional: override the published ports / image tags.
# LITELLM_PORT=4000
# VLLM_PORT=8000
# LITELLM_VERSION=latest
# VLLM_ARCH=latest-x86_64        # use latest-arm64 on Apple Silicon
# AS_CODE_VERSION=latest
