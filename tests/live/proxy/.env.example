# Copy to `.env` (or export in your shell). compose.yml reads these.
# Never commit real keys.
#
# Required: LiteLLM proxy master key. Used by the proxy AND as the admin API
# key for the integration tests (LITELLM_API_KEY).
# Per AGENTS.md §9, pin the exact proxy image this test suite was verified
# against (LITELLM_VERSION) for reproducible CI runs.
LITELLM_MASTER_KEY=sk-tests-master-key-change-me
LITELLM_VERSION=v1.97.0
LITELLM_PORT=4000
